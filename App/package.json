{
  "name": "Florde",
  "version": "1.0.0",
  "description": "AI-powered code generation from natural language",
  "main": "out/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build:bundle": "electron-vite build",
    "build": "electron-builder --win --linux",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "dockview-core": "^7.0.4",
    "fuse.js": "^7.4.2",
    "monaco-editor": "^0.45.0",
    "node-pty": "^1.1.0",
    "rfb2": "^0.2.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^5.0.0"
  },
  "build": {
    "appId": "com.florde.app",
    "productName": "Florde",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "LICENSE.txt"
    ],
    "icon": "../config/icon/icon.png",
    "directories": {
      "output": "build-output"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../config/icon/icon.ico",
      "artifactName": "Florde-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "runAfterFinish": true,
      "license": "LICENSE.txt",
      "installerIcon": "../config/icon/icon.ico",
      "uninstallerIcon": "../config/icon/icon.ico",
      "installerSidebar": "../config/icon/installer-sidebar.bmp",
      "uninstallDisplayName": "Florde ${version}",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "de_DE"
      ],
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": true,
      "warningsAsErrors": false,
      "differentialPackage": true,
      "unicode": true,
      "include": "installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "../config/icon/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Florde-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        "AppImage"
      ],
      "icon": "../config/icon",
      "category": "Development",
      "synopsis": "AI-powered code generation",
      "description": "Florde is an AI coding assistant that generates code from natural language.",
      "artifactName": "Florde-${version}-${arch}.${ext}"
    }
  }
}
