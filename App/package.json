{
  "name": "Florde",
  "version": "1.0.0",
  "description": "AI-powered code generation from natural language",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "monaco-editor": "^0.45.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.florde.app",
    "productName": "Florde",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "LICENSE.txt"
    ],
    "icon": "../config/icon/icon.png",
    "win": {
      "target": "nsis",
      "icon": "../config/icon/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "license": "LICENSE.txt",
      "installerIcon": "../config/icon/icon.ico",
      "installerSidebar": "../config/icon/installer-sidebar.bmp"
    },
    "fileAssociations": [
      { "ext": "py", "name": "Python", "description": "Python Source File", "icon": "../config/icon/icon.ico" },
      { "ext": "js", "name": "JavaScript", "description": "JavaScript File", "icon": "../config/icon/icon.ico" },
      { "ext": "ts", "name": "TypeScript", "description": "TypeScript File", "icon": "../config/icon/icon.ico" },
      { "ext": "md", "name": "Markdown", "description": "Markdown File", "icon": "../config/icon/icon.ico" },
      { "ext": "html", "name": "HTML", "description": "HTML File", "icon": "../config/icon/icon.ico" },
      { "ext": "css", "name": "CSS", "description": "CSS File", "icon": "../config/icon/icon.ico" },
      { "ext": "json", "name": "JSON", "description": "JSON File", "icon": "../config/icon/icon.ico" }
    ]
  }
}
